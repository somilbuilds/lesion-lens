# SkinLesionNet Environment Configuration
# Copy this file to .env and configure your keys locally.
# Never commit .env or share secret keys.

# Groq Clinical AI Copilot (Free tier at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Ports & Connectivity (Flexible local ports)
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Render Frontend CI/CD Automation (Connects Render static frontend to your laptop backend)
RENDER_API_KEY=your_render_api_key_here
RENDER_SERVICE_ID=srv-db3dis5g1s2s73a0uovg

# Cloudflare Tunnel (Optional: if omitted, an instant Quick Tunnel *.trycloudflare.com is created)
CLOUDFLARE_TUNNEL_TOKEN=
